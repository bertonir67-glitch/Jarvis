# Copie para .env (ou configure nos Secrets do Replit)

# Senha do painel administrativo
ADMIN_SENHA=troque-esta-senha

# Chave da IA (opcional). Sem ela o assistente roda no modo local por regras.
# Pegue gratis em https://console.groq.com
GROQ_API_KEY=

# Modelo usado no Groq
GROQ_MODELO=llama-3.3-70b-versatile

# Porta do servidor
PORT=3000

# Fuso horario do negocio
TZ_NEGOCIO=America/Sao_Paulo

# --- WhatsApp Cloud API (opcional) ---
# Sem estas variaveis as mensagens ficam na Central de Mensagens para envio manual.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
